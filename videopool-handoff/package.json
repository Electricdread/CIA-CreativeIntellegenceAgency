{
  "name": "videopool",
  "version": "0.1.1",
  "description": "VideoPool - multimedia download hub with bundled yt-dlp",
  "main": "dist/main.js",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "dev": "vite",
    "build": "vite build && electron-builder",
    "prepare-resources": "powershell -ExecutionPolicy Bypass -File scripts\\prepare-resources.ps1",
    "test:flow": "powershell -ExecutionPolicy Bypass -File scripts\\test_flow.ps1 -Url https://www.youtube.com/watch?v=mcg4z1gGbEw"
  },
  "files": [
    "resources/**"
  ],
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
